# Environment Configuration
# Copy this file to .env and update the values according to your environment

# Database Configuration
DATABASE_URL=sqlite:///./secure_pass.db
DATABASE_PATH=./secure_pass.db

# Application Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
RELOAD=True

# Security Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Data Directories (relative to project root)
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
CLEANED_DATA_DIR=./data/cleaned
TRASH_DATA_DIR=./data/trash
VALID_PLATES_DIR=./data/VALID_PLATES
CUSTOM_DATASET_DIR=./data/custom_dataset
DEBUG_DIR=./debug

# Model Configuration
YOLO_MODEL_PATH=./yolo_v8_custom_updated/weights/best.pt

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,bmp

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/secure_pass.log